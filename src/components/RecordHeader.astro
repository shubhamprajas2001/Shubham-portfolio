---
import '../styles/record.css';
import { profile, links } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const stages = [
  { k: 'Learn', cat: 'cloud', d: 'Four Salesforce certifications and the Apex Specialist superbadge.' },
  { k: 'Build', sub: 'Apex / LWC', cat: 'apex', d: 'Apex classes, triggers and batch jobs, with Lightning Web Components and Aura on the front end.' },
  { k: 'Integrate', cat: 'integ', d: 'A Connected App set up for the VTP project, with Apex classes behind it.' },
  { k: 'Automate', cat: 'auto', d: 'Flows, Approval Processes and workflow rules, plus CPQ pricing and product rules.' },
  { k: 'Ship', cat: 'lwc', d: 'Deployments with the Ant migration tool and Change Sets, up to production and Go-Live support.' },
];
const fields = [
  ['Experience', '4+ yrs'],
  ['Company', 'Fexle Services'],
  ['Domain', 'Real estate'],
];
---
<section id="top" class="rec-head panel rh" aria-labelledby="rh-title">
  <div class="rh-deco" aria-hidden="true"></div>
  <div class="rh-main">
    <div class="rh-avatar" aria-hidden="true"><span>SK</span></div>
    <div class="rh-id">
      <p class="rh-obj"><span class="rh-ico" aria-hidden="true">☁</span>{profile.role}</p>
      <h1 id="rh-title" class="rh-title">{profile.name}</h1>
      <p class="rh-pitch">{profile.pitch}</p>
    </div>
    <div class="rh-actions" role="group" aria-label="Actions">
            <a class="rh-btn" href={`mailto:${links.email}`}>Email</a>
      {links.linkedin && <a class="rh-btn" href={links.linkedin} target="_blank" rel="noopener noreferrer">Linkedin</a>}
      {links.trailhead && <a class="rh-btn" href={links.trailhead} target="_blank" rel="noopener noreferrer">Trailhead</a>}
      <a class="rh-btn" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>

  <dl class="rh-fields">
    {fields.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}
    <div><dt>Status</dt><dd class="rh-ok"><i aria-hidden="true"></i>Open to new roles</dd></div>
  </dl>

  <div class="rh-path" data-path>
    <ol class="rh-steps" aria-label="Record path">
      {stages.map((s, i) => (
        <li data-cat={s.cat}>
          <button type="button" class:list={['rh-step', { on: i === 0 }]} data-d={s.d} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="rh-n" aria-hidden="true">{i + 1}</span>
            <span class="rh-k">{s.k}{s.sub && <small>{s.sub}</small>}</span>
          </button>
        </li>
      ))}
    </ol>
    <p class="rh-desc" aria-live="polite" data-path-desc>{stages[0].d}</p>
  </div>
</section>

<script>
  document.querySelectorAll('[data-path]').forEach((p) => {
    const out = p.querySelector('[data-path-desc]');
    const btns = [...p.querySelectorAll('.rh-step')];
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      out.textContent = b.dataset.d;
      out.style.setProperty('--c', getComputedStyle(b.parentElement).getPropertyValue('--c'));
    }));
  });
</script>
