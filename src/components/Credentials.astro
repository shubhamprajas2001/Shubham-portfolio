---
import '../styles/record.css';
import { certifications, superbadges, education, links } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const groups = [['Certifications', certifications.map((c) => ({ ...c, sub: c.sub ?? 'Certification' }))], ['Superbadges', superbadges]];
---
<section id="credentials" class="panel cr rv" aria-labelledby="cr-h">
  <header class="rc-hd"><h2 id="cr-h"><span class="rc-ico" aria-hidden="true">❏</span>Files <small>({certifications.length + superbadges.length})</small></h2></header>
  {groups.map(([t, items]) => (
    <div class="cr-grp">
      <h3>{t}</h3>
      <ul class="cr-grid">
        {items.map((b) => (
          <li>
            <a class="cr-tile" href={links.trailhead || undefined} target="_blank" rel="noopener noreferrer">
              {b.img && <img src={`${base}img/${b.img}`} alt="" width="64" height="64" loading="lazy" decoding="async" />}
              <span class="cr-name">{b.name}</span>
              <span class="cr-sub">{b.sub}</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
  {education.length > 0 && <div class="cr-grp">
    <h3>Education</h3>
    <ul class="cr-edu">
      {education.map((e) => (
        <li><strong>{e.degree}</strong><span>{e.school}</span><em>{e.when}</em></li>
      ))}
    </ul>
  </div>}
</section>
